# ---------------------------------------------------------------------------
# CodeLens AI — environment configuration
# Copy to `.env.local` and fill in. Every value below is OPTIONAL: with no
# .env.local at all the app runs in Demo Mode and every feature still works.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Review engine — pick ONE. With neither set, reviews run on the local
# analysis engine, which works but is not a real model.
#
# Whichever key is present wins; Anthropic takes precedence if both are.
# Never prefix either with NEXT_PUBLIC_ — they must stay on the server.
# ---------------------------------------------------------------------------

# --- Option A: Google Gemini — FREE, no credit card ------------------------
# Get a key in ~2 minutes at https://aistudio.google.com/apikey
# This is the one to use if you don't want to spend money.
GEMINI_API_KEY=

# The default the app starts on. Visitors can switch between the free models
# from Settings; this only sets the starting point.
#
# Verified working on a newly issued free key: gemini-3.5-flash,
# gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite.
# Do NOT use gemini-2.5-* — documented as stable and free, still listed by
# ListModels, but 404 "no longer available to new users" on a new key.
# Avoid *-preview ids too; they get retired without notice.
GEMINI_MODEL=gemini-3.5-flash

# --- Option B: Anthropic — paid, and the better reviewer -------------------
# Requires BOTH the key and the explicit opt-in below. A key on its own is
# NOT treated as consent to spend: a key inherited from a template or a
# copied project would otherwise start billing silently. Gemini is preferred
# whenever both are configured.
ALLOW_PAID_PROVIDER=false
ANTHROPIC_API_KEY=

# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# The route sends only the parameters each model actually supports, so
# switching this is safe — see src/lib/ai/providers/anthropic.js.
ANTHROPIC_MODEL=claude-opus-5

# low | medium | high | xhigh | max. Ignored by models without an effort
# ladder (claude-haiku-4-5), rather than sent and rejected.
ANTHROPIC_EFFORT=high

# Allow visitors to paste their own Anthropic OR Gemini key in Settings
# (stored in their browser only, sent per-request over HTTPS, never
# persisted server-side). The provider is detected from the key prefix.
NEXT_PUBLIC_ALLOW_BYO_KEY=true

# Force the simulated reviewer even when a key is present. Useful for demos
# and for keeping a public deployment free to run.
NEXT_PUBLIC_FORCE_DEMO_MODE=false

# Shown in the footer / OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your public repository. When set, a "Source" link appears in the footer —
# worth having on a portfolio piece. Left empty, the link is omitted rather
# than pointing somewhere useless.
NEXT_PUBLIC_REPO_URL=

# How many proxy hops sit in front of the app. The rate limiter counts back
# from the RIGHT of X-Forwarded-For by this many entries, because the leftmost
# entry is whatever the client sent and can be forged to mint a fresh bucket
# per request. Vercel, Netlify and Cloudflare are detected automatically; set this only
# for a self-hosted reverse proxy.
TRUSTED_PROXY_HOPS=1
